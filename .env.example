# NEAR testnet (contrat tokengo-mt + operator backend)
NEAR_NETWORK=
NEAR_RPC_URL=
NEAR_CONTRACT_ID=
NEAR_OPERATOR_ID=
NEAR_OPERATOR_KEY=

# NEAR AI Cloud (crédits réels) — vide = crédits simulés. Voir Docs/07 et apps/server/scripts/nearai-spike.ts
# Compte NEAR *mainnet* + sa clé FULL-ACCESS (ed25519:…) : sert seulement à signer un message NEP-413 (aucune transaction).
NEARAI_AUTH_ACCOUNT=
NEARAI_AUTH_KEY=
# Facultatifs : découverts via l'API si vides (1re organisation dont le compte est owner, 1er workspace actif)
NEARAI_ORG_ID=
NEARAI_WORKSPACE_ID=
# Clé sk-… dédiée aux marchands (sinon créée une fois avec spendLimit = poche NPC $1 et stockée chiffrée)
NEARAI_NPC_KEY=
# 1 = forcer les crédits réels, 0 = forcer le simulé (défaut : réel si NEARAI_AUTH_* présents)
FEATURE_REAL_CREDITS=
# 32 octets base64 (openssl rand -base64 32) : chiffre clés API joueurs et refresh token NEAR AI
MASTER_KEY=
