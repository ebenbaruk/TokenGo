# NEAR testnet (contrat tokengo-mt + operator backend)
NEAR_NETWORK=
NEAR_RPC_URL=
NEAR_CONTRACT_ID=
NEAR_OPERATOR_ID=
NEAR_OPERATOR_KEY=
# Préfixe des sous-comptes (défaut : vide en production, "dev-" sinon — les bases de dev ne polluent pas les comptes de la démo)
# NEAR_ACCOUNT_PREFIX=dev-

# NEAR AI Cloud (crédits réels) — vide = crédits simulés. Voir Docs/07 et apps/server/scripts/nearai-spike.ts
# Compte NEAR *mainnet* + sa clé FULL-ACCESS (ed25519:…) : sert seulement à signer un message NEP-413 (aucune transaction).
NEARAI_AUTH_ACCOUNT=
NEARAI_AUTH_KEY=
# Facultatifs : découverts via l'API si vides (1re organisation dont le compte est owner, 1er workspace actif)
NEARAI_ORG_ID=
NEARAI_WORKSPACE_ID=
# Clé sk-… dédiée aux marchands (sinon créée une fois avec spendLimit = poche NPC $1 et stockée chiffrée)
NEARAI_NPC_KEY=
# 1 = forcer les crédits réels, 0 = forcer le simulé (défaut : réel si NEARAI_AUTH_* présents)
FEATURE_REAL_CREDITS=
# 32 octets base64 (openssl rand -base64 32) : chiffre clés API joueurs et refresh token NEAR AI
MASTER_KEY=

# Google OAuth (vide = bouton Google masqué). Redirect URI à déclarer chez Google : PUBLIC_URL + /auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Runners-agents (PNJ joueurs qui font vivre le marché) : nombre, 0 = désactivés (défaut : 24 si JOBS, sinon 0).
RUNNERS=24
# 0 = les runners marchent et capturent mais ne commercent pas (e2e)
RUNNER_TRADES=1

# Nombre de proxys de confiance devant le serveur (X-Forwarded-For). 1 en prod (Railway/Fly), 0 en local.
TRUST_PROXY=

# Monde « partout » : quartier généré autour d'un joueur GPS hors de Paris (1 = actif, défaut)
WORLD_ANYWHERE=1
# Miroirs Overpass (virgules) ; off = génération procédurale seulement (hors ligne)
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Admin : pause Forge, événements de ville (POST /api/admin/event avec Authorization: Bearer <ADMIN_TOKEN>) ; vide = désactivé
ADMIN_TOKEN=
